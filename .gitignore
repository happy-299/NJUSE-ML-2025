# 忽略所有文件和目录
/*

# 保留 .gitignore 本身
!.gitignore

# 保留 README 中列出的顶层文件
!README.md
!requirements.txt
!config.py
!QUICKSTART.md

# 保留 README 中列出的目录及其子内容
!data/
!data/**
!level1/
!level1/**
!level2/
!level2/**
!level3/
!level3/**
!utils/
!utils/**
!outputs/
!outputs/**
!notebooks/
!notebooks/**

# 保留各目录中的 README.md（确保子目录的说明文件也被跟踪）
!**/README.md

# 忽略大文件和模型权重
*.bin
*.pth
*.pt
*.ckpt
*.safetensors
pytorch_model.bin
model.safetensors

# 忽略 level3 的模型文件夹（已有模型）
level3/codereviewer/pytorch_model.bin

# 忽略原始数据集（太大）
data/raw/

# 忽略 Python 缓存
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so

# 忽略环境变量文件
.env

# 忽略输出文件（实验结果）
outputs/**/*.json
outputs/**/*.csv
outputs/**/*.txt

# 但保留 .gitkeep
!**/.gitkeep

# === 补充常见大文件和临时文件类型 ===
# 数据文件格式
*.jsonl
*.csv
*.tsv
*.dat
*.h5
*.hdf5

# 模型和序列化文件
*.pkl
*.pickle

# 训练日志和监控
logs/
wandb/
tensorboard_logs/
*.log

# Jupyter Notebook 检查点
.ipynb_checkpoints/

# 虚拟环境
venv/
env/
conda-env/

# IDE 配置
.vscode/
.idea/
*.swp
*.swo

# 操作系统临时文件  
.DS_Store
Thumbs.db
ehthumbs.db

# 说明：根据 README.md 注意事项配置，避免提交大文件(数据集、模型权重)到 Git
level1/checkpoints/