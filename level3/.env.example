# LLM 配置

# 本地模型配置（推荐用于作业）
LLM_TYPE=local  # 选项: local, openai, ollama
LOCAL_MODEL_TYPE=codereviewer  # 选项: codereviewer, codegen
LOCAL_MODEL_PATH=D:/hehaochuan/codes/machine_learning/NJUSE-ML-2025/level3/codereviewer  # 本地模型路径
DEVICE=cuda  # 选项: cuda, cpu, auto

# OpenAI（可选，用于对比测试）
# OPENAI_API_KEY=your-api-key-here
# OPENAI_API_BASE=https://api.openai.com/v1

# Ollama（可选）
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=codellama

# 模型参数
MAX_LENGTH=512
NUM_BEAMS=5
TEMPERATURE=0.7

# 其他配置
LOG_LEVEL=INFO
MAX_RETRIES=3
TIMEOUT=60
